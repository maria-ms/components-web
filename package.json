{
  "name": "@maria-ms/components-web",
  "version": "1.0.0",
  "description": "Maria's Web Components.",
  "type": "module",
  "main": "./src/index.mjs",
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maria-ms/components-web.git"
  },
  "bugs": {
    "url": "https://github.com/maria-ms/components-web/issues"
  },
  "homepage": "https://github.com/maria-ms/components-web#readme",
  "exports": {
    ".": "./src/index.mjs",
    "./accordion": "./src/components/accordion/accordion.mjs",
    "./badge": "./src/components/badge/badge.mjs",
    "./avatar": "./src/components/avatar/avatar.mjs",
    "./avatar-presence": "./src/components/avatar/avatar.mjs",
    "./breadcrumbs": "./src/components/breadcrumbs/breadcrumbs.mjs",
    "./button": "./src/components/button/button.mjs",
    "./icon-button": "./src/components/button/button.mjs",
    "./checkbox": "./src/components/checkbox/checkbox.mjs",
    "./choice-field": "./src/components/choice-field/choice-field.mjs",
    "./dialog": "./src/components/dialog/dialog.mjs",
    "./data-table": "./src/components/data-table/data-table.mjs",
    "./data-table.schema.json": "./src/components/data-table/data-table.schema.json",
    "./field": "./src/components/field/field.mjs",
    "./link": "./src/components/link/link.mjs",
    "./number-input": "./src/components/number-input/number-input.mjs",
    "./progress": "./src/components/progress/progress.mjs",
    "./radio": "./src/components/radio/radio.mjs",
    "./radio-group": "./src/components/radio-group/radio-group.mjs",
    "./select": "./src/components/select/select.mjs",
    "./spinner": "./src/components/spinner/spinner.mjs",
    "./switch": "./src/components/switch/switch.mjs",
    "./tabs": "./src/components/tabs/tabs.mjs",
    "./text-input": "./src/components/text-input/text-input.mjs",
    "./textarea": "./src/components/textarea/textarea.mjs",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "for file in src/index.mjs src/components/*/*.mjs; do node --check \"$file\"; done",
    "skills:link": "node scripts/link-skills.mjs",
    "skills:unlink": "node scripts/unlink-skills.mjs",
    "prepack": "npm run check",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@maria-ms/tokens": "1.0.0"
  }
}
