{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maria.design/schemas/data-table.schema.json",
  "title": "Maria Data Table model",
  "description": "Serializable data for ds-data-table. Plain cells contain text, finite numbers, booleans, or empty values; rich cell content is supplied separately through cellRenderers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["caption", "rowKey", "columns", "rows"],
  "properties": {
    "caption": {
      "type": "string",
      "minLength": 1,
      "description": "A concise description of the table contents."
    },
    "rowKey": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["width"],
            "properties": { "width": { "const": "fill" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["rowHeader"],
            "properties": { "rowHeader": { "const": true } }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "rows": {
      "type": "array",
      "description": "Rows may carry arbitrary JSON data for named renderers. Values in columns without a renderer must be plain text, finite numbers, booleans, or empty.",
      "items": { "type": "object" }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedIds"],
      "properties": {
        "selectedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rowId" }
        }
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "direction"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["ascending", "descending"] }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["loading", "empty", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "rowId": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "number" }]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "width"],
      "not": {
        "required": ["hiddenLabel", "sortable"],
        "properties": {
          "hiddenLabel": { "const": true },
          "sortable": { "const": true }
        }
      },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "width": {
          "oneOf": [
            { "const": "fill" },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        },
        "align": { "enum": ["start", "center", "end"] },
        "hiddenLabel": { "type": "boolean" },
        "rowHeader": { "type": "boolean" },
        "sortable": { "type": "boolean" },
        "renderer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
